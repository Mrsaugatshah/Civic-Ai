# Server
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
BCRYPT_ROUNDS=12
TRUST_PROXY=false
EMAIL_VERIFICATION_REQUIRED=false

# Real transactional email (SMTP)
EMAIL_PROVIDER=smtp
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_REQUIRE_TLS=true
EMAIL_USER=replace-with-provider-username
EMAIL_PASSWORD=replace-with-provider-password
EMAIL_FROM=CivicAI <no-reply@example.com>

# Backend-only AI provider (OpenAI-compatible Chat Completions API)
# Primary + automatic fallback providers. Both keys stay server-side.
AI_PROVIDER=groq
AI_FALLBACK_PROVIDERS=nvidia
GROQ_API_KEY=replace-with-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1
NVIDIA_API_KEY=replace-with-nvidia-api-key
NVIDIA_MODEL=meta/llama-3.1-70b-instruct
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Gemini remains supported if you prefer it as the primary provider.
AI_API_KEY=replace-with-provider-api-key
AI_MODEL=gemini-flash-latest
AI_TIMEOUT_MS=20000
AI_MAX_RETRIES=2
AI_ENABLE_IMAGE_ANALYSIS=false
AI_RETRY_RATE_LIMIT=5
AI_RETRY_FAILED_ON_STARTUP=true

# Report controls
REPORT_RATE_LIMIT=10
GUEST_REPORT_RATE_LIMIT=5
SQLITE_PATH=server/civicai.sqlite
UPLOAD_PATH=server/uploads
