# Server
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
BCRYPT_ROUNDS=12
TRUST_PROXY=false
EMAIL_VERIFICATION_REQUIRED=true

# Real transactional email (SMTP)
EMAIL_PROVIDER=smtp
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_REQUIRE_TLS=true
EMAIL_USER=replace-with-provider-username
EMAIL_PASSWORD=replace-with-provider-password
EMAIL_FROM=CivicAI <no-reply@example.com>

# Backend-only AI provider (OpenAI-compatible Chat Completions API)
AI_PROVIDER=openai-compatible
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=replace-with-provider-api-key
AI_MODEL=replace-with-model-name
AI_TIMEOUT_MS=20000
AI_MAX_RETRIES=2
AI_ENABLE_IMAGE_ANALYSIS=false
AI_RETRY_RATE_LIMIT=5

# Report controls
REPORT_RATE_LIMIT=10
SQLITE_PATH=server/civicai.sqlite
UPLOAD_PATH=server/uploads
